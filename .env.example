# Copy these into Netlify → Site configuration → Environment variables.
# Never commit a real .env file with actual secrets.

BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
BOT_USERNAME=your_bot_username_without_at

CHANNEL_1_ID=-1001111111111
CHANNEL_1_INVITE_LINK=https://t.me/+xxxxxxxxxxxxxxxx

CHANNEL_2_ID=-1002222222222
CHANNEL_2_INVITE_LINK=https://t.me/+yyyyyyyyyyyyyyyy

CHANNEL_3_ID=-1003333333333
CHANNEL_3_INVITE_LINK=https://t.me/+zzzzzzzzzzzzzzzz

REFERRAL_TARGET=3
VIP_URL=https://example.com/vip
ADMIN_ID=123456789

# Random long string you invent yourself — secures the webhook + the /verify admin endpoint
WEBHOOK_SECRET=change-this-to-a-long-random-string

# Full Firebase service account JSON, pasted as ONE line (see README for how to get this)
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}
